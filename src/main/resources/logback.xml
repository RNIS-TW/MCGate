<?xml version="1.0" encoding="UTF-8"?>
<!-- Console pattern intentionally mirrors the old slf4j-simple output ("HH:mm:ss [LEVEL] msg")
     since ConsoleColors.kt regex-matches that exact shape to colorize/re-route it through JLine. -->
<configuration>
    <!-- Suppresses logback's own internal status messages (the "|-INFO in ch.qos.logback...."
         lines about appenders/policies being instantiated). Logback auto-dumps its full status
         history to the console whenever a WARN/ERROR occurs during setup (e.g. our
         FixedWindowRollingPolicy maxIndex getting clamped) - NopStatusListener disables that
         entirely, regardless of whether such warnings happen. This only affects logback's own
         diagnostic noise, not MCGate's application logging (root level below). -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!-- me.hippodev.ColorConsoleAppender (not logback's stock ConsoleAppender): routes each line
         through System.err.println so ConsoleColors.kt can colourise it, queue it off the Netty
         event loop, and print it above the JLine prompt. The pattern must stay "HH:mm:ss [LEVEL]
         msg" - ConsoleColors.kt's LINE_PATTERN regex-matches that exact shape. -->
    <appender name="CONSOLE" class="me.hippodev.ColorConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} [%level] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- LogArchiver.kt gzips the *previous run's* log/latest.log into a timestamped
         log/<date>_<time>.log.gz before this appender opens, so every run starts a fresh
         latest.log. Within a single run, this RollingFileAppender additionally rolls latest.log
         itself every 10,000 lines (see LineCountTriggeringPolicy) - log/latest.log becomes
         log/latest.1.log.gz (bumping any existing latest.1.log.gz to latest.2.log.gz, etc.) and
         logging continues into a fresh latest.log - so one long-lived run never grows a single
         endless log file. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>log/latest.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>log/latest.%i.log.gz</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>7</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="me.hippodev.LineCountTriggeringPolicy" />
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%level] %msg%n</pattern>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
